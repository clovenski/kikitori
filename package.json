{
  "name": "kikitori",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "kikitori": "tsx src/cli/index.ts",
    "setup:tools": "tsx scripts/fetch-tools.ts",
    "pin:tools": "tsx scripts/pin-tools.ts",
    "test": "vitest run",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.web.json",
    "dev:app": "electron-vite dev",
    "build:app": "electron-vite build",
    "smoke:app": "node scripts/smoke-app.mjs",
    "build:installer": "electron-vite build && electron-builder --config electron-builder.yml --win nsis --x64 --publish never",
    "smoke:installed": "node scripts/smoke-installed.mjs",
    "make:icon": "node scripts/make-icon.mjs"
  },
  "dependencies": {
    "extract-zip": "^2.0.1"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "commander": "^15.0.0",
    "electron": "^44.7.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "6.0.0-beta.8",
    "eslint": "^10.12.0",
    "jsdom": "^30.1.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  },
  "main": "out/main/index.js",
  "description": "Transcribe, translate and summarize Japanese YouTube videos locally",
  "license": "MIT",
  "author": {
    "name": "Joel Tengco"
  },
  "packageManager": "pnpm@12.11.2"
}
